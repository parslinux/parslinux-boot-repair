#!/usr/bin/env python3
import sys
import os

# Check if we should elevate to root via pkexec
if os.geteuid() != 0 and os.environ.get("NO_PKEXEC", "0") != "1":
    args = ["pkexec"] + sys.argv
    try:
        os.execvp("pkexec", args)
    except Exception as e:
        print(f"Failed to elevate with pkexec: {e}", file=sys.stderr)
        sys.exit(1)

# Determine app directory (local repo vs installed package)
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if os.path.isdir(os.path.join(SCRIPT_DIR, "src")):
    sys.path.insert(0, os.path.join(SCRIPT_DIR, "src"))
elif os.path.isdir("/usr/share/parslinux/parslinux-boot-repair/"):
    sys.path.insert(0, "/usr/share/parslinux/parslinux-boot-repair/")
elif os.path.isdir("/usr/share/pardus/pardus-boot-repair/"):
    sys.path.insert(0, "/usr/share/pardus/pardus-boot-repair/")

import Main
