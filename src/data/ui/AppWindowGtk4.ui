<?xml version="1.0" encoding="UTF-8"?>
<interface domain="parslinux-boot-repair">
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="AdwApplicationWindow" id="window_main">
    <property name="title" translatable="yes">Pars Linux Boot Repair</property>
    <property name="default-width">720</property>
    <property name="default-height">540</property>
    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkStack" id="deck_main">
            <property name="transition-type">slide-left-right</property>
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>

            <!-- 1. MAIN PAGE -->
            <child>
              <object class="GtkStackPage">
                <property name="name">box_page_main</property>
                <property name="child">
                  <object class="GtkBox" id="box_page_main">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                        <child type="end">
                          <object class="GtkButton" id="button_about">
                            <property name="icon-name">help-about-symbolic</property>
                            <property name="tooltip-text" translatable="yes">About</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">600</property>
                            <property name="tightening-threshold">400</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">16</property>
                                <property name="margin-end">16</property>

                                <!-- Logo & Title -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <property name="halign">center</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="pixel-size">72</property>
                                        <property name="resource">/org/parslinux/boot-repair/images/parslinux-boot-repair.svg</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Pars Linux Boot Repair</property>
                                        <style>
                                          <class name="title-1"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Select an action to repair or restore your system</property>
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <!-- Quick Actions List -->
                                <child>
                                  <object class="GtkListBox">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                    <child>
                                      <object class="AdwActionRow" id="row_reinstall_grub">
                                        <property name="title" translatable="yes">Reinstall GRUB Bootloader</property>
                                        <property name="subtitle" translatable="yes">Reinstalls the GRUB bootloader to ensure the system can boot properly.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">media-floppy-symbolic</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_reset_password">
                                        <property name="title" translatable="yes">Reset password</property>
                                        <property name="subtitle" translatable="yes">Resets the user account password.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">dialog-password-symbolic</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_fix_broken">
                                        <property name="title" translatable="yes">Fix Broken Packages</property>
                                        <property name="subtitle" translatable="yes">Attempts to repair broken packages.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">package-x-generic-symbolic</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_update">
                                        <property name="title" translatable="yes">Update system</property>
                                        <property name="subtitle" translatable="yes">Updates all installed packages to the latest versions.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">software-update-available-symbolic</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_advanced_options">
                                        <property name="title" translatable="yes">Advanced options</property>
                                        <property name="subtitle" translatable="yes">Reinstall system, Repair filesystem, Open chroot shell...</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">preferences-system-symbolic</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- 2. ADVANCED OPTIONS PAGE -->
            <child>
              <object class="GtkStackPage">
                <property name="name">box_page_advanced</property>
                <property name="child">
                  <object class="GtkBox" id="box_page_advanced">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkButton" id="button_mainpage">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Back to Main Page</property>
                          </object>
                        </child>
                        <property name="title-widget">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Advanced Options</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">600</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="margin-top">20</property>
                                <property name="margin-bottom">20</property>
                                <property name="margin-start">16</property>
                                <property name="margin-end">16</property>
                                <child>
                                  <object class="GtkListBox">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                    <child>
                                      <object class="AdwActionRow" id="row_reinstall">
                                        <property name="title" translatable="yes">Reinstall system</property>
                                        <property name="subtitle" translatable="yes">Completely reinstalls the operating system.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">system-reboot-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_repair_filesystem">
                                        <property name="title" translatable="yes">Repair filesystem</property>
                                        <property name="subtitle" translatable="yes">Scans and repairs the filesystem for errors to ensure data integrity.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">drive-harddisk-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_reset_config">
                                        <property name="title" translatable="yes">Reset User Configuration</property>
                                        <property name="subtitle" translatable="yes">Reverts settings to default, erasing custom user configurations.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">user-trash-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_dump_log">
                                        <property name="title" translatable="yes">Extract system logs</property>
                                        <property name="subtitle" translatable="yes">Retrieves system logs for analysis and troubleshooting purposes.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">text-x-generic-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="row_chroot">
                                        <property name="title" translatable="yes">Open Chroot Shell</property>
                                        <property name="subtitle" translatable="yes">Opens a chroot environment for system maintenance or recovery tasks.</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">utilities-terminal-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- 3. QUESTIONS / WIZARD PAGE -->
            <child>
              <object class="GtkStackPage">
                <property name="name">box_page_questions</property>
                <property name="child">
                  <object class="GtkBox" id="box_page_questions">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwHeaderBar" id="titlebar_page_questions">
                        <child type="start">
                          <object class="GtkButton" id="button_mainpage1">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Back</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="button_questions_continue">
                            <property name="label" translatable="yes">Continue</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwCarousel" id="carousel_questions">
                        <property name="vexpand">True</property>
                        <property name="hexpand">True</property>
                        <property name="allow-mouse-drag">False</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- 4. LOADING & VTE STATUS PAGE -->
            <child>
              <object class="GtkStackPage">
                <property name="name">box_page_loading</property>
                <property name="child">
                  <object class="GtkBox" id="box_page_loading">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkButton" id="button_loading_to_mainpage">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Return to Main Page</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="button_close_logs">
                            <property name="icon-name">view-restore-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Hide Terminal Output</property>
                            <property name="visible">False</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="button_show_log">
                            <property name="icon-name">utilities-terminal-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Show Live Logs</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="button_copy_logs">
                            <property name="icon-name">edit-copy-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Copy Logs to Clipboard</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">True</property>
                        <property name="hexpand">True</property>
                        <child>
                          <object class="AdwStatusPage" id="page_status">
                            <property name="title">Processing...</property>
                            <property name="description">Please wait while the system is being repaired.</property>
                            <property name="icon-name">content-loading-symbolic</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkSpinner" id="spinner_page_loading">
                                <property name="spinning">True</property>
                                <property name="halign">center</property>
                                <property name="margin-top">12</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="box_vte">
                            <property name="orientation">vertical</property>
                            <property name="vexpand">True</property>
                            <property name="hexpand">True</property>
                            <property name="visible">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
