#!/usr/bin/env bash
while [[ ! -b /dev/$disk ]] ; do
    echo $(ls /sys/block/* | grep "[0-9]$")
    echo -n "partition >>> "
    read disk
done
fs="$(lsblk -rno FSTYPE /dev/$disk | head -n 1)"

if [[ -f /usr/bin/parslinux-open-luks-lvm ]]; then
    source /usr/bin/parslinux-open-luks-lvm
elif [[ -f "$(dirname "$0")/parslinux-open-luks-lvm" ]]; then
    source "$(dirname "$0")/parslinux-open-luks-lvm"
elif [[ -f /usr/bin/pardus-open-luks-lvm ]]; then
    source /usr/bin/pardus-open-luks-lvm
elif command -v parslinux-open-luks-lvm >/dev/null 2>&1; then
    source "$(command -v parslinux-open-luks-lvm)"
fi

set -e
if [[ "$fs" == "ext4" ]] ; then
    yes "" | fsck.ext4 -f -y /dev/$disk

elif [[ "$fs" == "btrfs" ]] ; then
    yes "" | btrfs check --force --repair /dev/$disk
else
    fsck.$fs /dev/$disk
fi
